CAPI=2:

#-----------------------------------------------------------------------------
# Title      : Ram Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : ram.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2021
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2021-10-26  1.0.0    mrosiere Created
# 2025-08-01  1.1.0    mrosiere Add option to have asynchronous or synchronous read port
# 2025-09-05  1.1.1    mrosiere Add Package
# 2026-05-16  1.2.0    mrosiere Add ram_1rw and sbi_ram_1rw
# 2026-06-06  1.2.1    mrosiere Add Name
# 2026-09-15  1.2.2    mrosiere Add ram_2r1w
# 2026-10-05  1.2.3    mrosiere Remove unused std.textio, assert DEPTH power of 2
#                               UVVM testbench of all the RAMs (replaces
#                               tb_ram_1r1w), targets use WIDTH/DEPTH/SYNC_READ
#-----------------------------------------------------------------------------

name        : asylum:component:ram:1.2.3
description : RAM with 1 read port and 1 write port

filesets:

  #---------------------------------------
  # Source Files
  #---------------------------------------
  files_hdl:
    files:
      - hdl/ram_pkg.vhd
      - hdl/ram_1r1w.vhd
      - hdl/ram_2r1w.vhd
      - hdl/ram_1rw.vhd
      - hdl/sbi_ram.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend :
      - asylum:utils:pkg
      
  #---------------------------------------
  # Testbench Files
  #---------------------------------------
  files_sim:
    files:
      - sim/tb_ram.vhd
    file_type : vhdlSource-2008
    depend    :
      - bitvis:verification:uvvm

  #---------------------------------------
  # Lint / synthesis check : wrapper and ghdl_synth.sh / ghdl_synth.mk
  # (pre_run hook of lint_ghdl_synth_*), copy of tools/ghdl of
  # asylum:utils:generators : no dependency to generators (cycle
  # generators -> fifo -> ram -> pkg)
  #---------------------------------------
  syn:
    files        :
      - syn/ram_wrapper.vhd
      - syn/ghdl/ghdl_synth.sh : {file_type : user, copyto : ghdl_synth.sh}
      - syn/ghdl/ghdl_synth.mk : {file_type : user, copyto : ghdl_synth.mk}
    file_type    : vhdlSource-2008
    logical_name : asylum

targets:

  #---------------------------------------
  # Default Target
  #---------------------------------------
  default: &default
    description     : Default Target
    filesets        :
      - files_hdl
    toplevel        : ram_1r1w
    default_tool    : ghdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of ram_wrapper, all RAMs)
    toplevel        : asylum.ram_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of ram_wrapper with the generics of the target.
  # The pre_run hook (syn/ghdl/ghdl_synth.sh) adds syn/ghdl/ghdl_synth.mk
  # to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of ram_wrapper, 32x32 bits, asynchronous read (default generics)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_32x32b_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of ram_wrapper, 32x32 bits, synchronous read
    parameters      :
      - SYNC_READ=true

  #---------------------------------------
  lint_ghdl_synth_16x8b_read_async :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of ram_wrapper, 16x8 bits, asynchronous read
    parameters      :
      - WIDTH=8
      - DEPTH=16

  #---------------------------------------
  lint_ghdl_synth_16x8b_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of ram_wrapper, 16x8 bits, synchronous read
    parameters      :
      - WIDTH=8
      - DEPTH=16
      - SYNC_READ=true

  #---------------------------------------
  lint_ghdl_synth_256x8b_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of ram_wrapper, 256x8 bits, synchronous read
    parameters      :
      - WIDTH=8
      - DEPTH=256
      - SYNC_READ=true

  sim_16x8b_sync_read:
    << : *default
    description     : All RAMs and sbi_ram, asynchronous read (WIDTH=8, DEPTH=16)
    filesets_append :
      - files_sim
    toplevel        : tb_ram
    parameters      :
      - WIDTH=8
      - DEPTH=16
      - SYNC_READ=false
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  sim_16x8b_async_read:
    << : *default
    description     : All RAMs and sbi_ram, synchronous read (WIDTH=8, DEPTH=16)
    filesets_append :
      - files_sim
    toplevel        : tb_ram
    parameters      :
      - WIDTH=8
      - DEPTH=16
      - SYNC_READ=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  sim_64x32b_sync_read:
    << : *default
    description     : All RAMs and sbi_ram, asynchronous read (WIDTH=32, DEPTH=64)
    filesets_append :
      - files_sim
    toplevel        : tb_ram
    parameters      :
      - WIDTH=32
      - DEPTH=64
      - SYNC_READ=false
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  sim_64x32b_async_read:
    << : *default
    description     : All RAMs and sbi_ram, synchronous read (WIDTH=32, DEPTH=64)
    filesets_append :
      - files_sim
    toplevel        : tb_ram
    parameters      :
      - WIDTH=32
      - DEPTH=64
      - SYNC_READ=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

scripts:

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

parameters :

  WIDTH :
    description : Word width
    datatype    : int
    default     : 8
    paramtype   : generic

  DEPTH :
    description : Number of words (power of 2, >= 16 for the testbench)
    datatype    : int
    default     : 16
    paramtype   : generic

  SYNC_READ :
    description : Synchronous (registered) read
    datatype    : bool
    default     : false
    paramtype   : generic
